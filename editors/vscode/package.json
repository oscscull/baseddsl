{
  "name": "based-vscode",
  "displayName": "Based DSL",
  "description": "Language support for the Based DSL (.bsl): diagnostics, inlay hints, and hover via based-lsp.",
  "version": "0.1.12",
  "license": "AGPL-3.0-only",
  "publisher": "based",
  "repository": {
    "type": "git",
    "url": "https://github.com/oscscull/baseddsl.git",
    "directory": "editors/vscode"
  },
  "engines": {
    "vscode": "^1.75.0"
  },
  "categories": [
    "Programming Languages"
  ],
  "activationEvents": [
    "onLanguage:bsl"
  ],
  "main": "./out/extension.js",
  "contributes": {
    "languages": [
      {
        "id": "bsl",
        "aliases": [
          "Based DSL",
          "bsl"
        ],
        "extensions": [
          ".bsl"
        ],
        "configuration": "./language-configuration.json"
      },
      {
        "id": "based-mig",
        "aliases": [
          "Based Migration"
        ],
        "extensions": [
          ".mig"
        ],
        "configuration": "./language-configuration.json"
      },
      {
        "id": "based-snap",
        "aliases": [
          "Based Snapshot"
        ],
        "extensions": [
          ".snap"
        ],
        "configuration": "./language-configuration.json"
      }
    ],
    "grammars": [
      {
        "language": "bsl",
        "scopeName": "source.bsl",
        "path": "./syntaxes/bsl.tmLanguage.json"
      },
      {
        "language": "based-mig",
        "scopeName": "source.mig",
        "path": "./syntaxes/mig.tmLanguage.json",
        "embeddedLanguages": {
          "meta.embedded.block.sql": "sql"
        }
      },
      {
        "language": "based-snap",
        "scopeName": "source.snap",
        "path": "./syntaxes/snap.tmLanguage.json"
      }
    ],
    "configuration": {
      "title": "Based DSL",
      "properties": {
        "basedls.serverPath": {
          "type": "string",
          "default": "based-lsp",
          "description": "Path to the matching based-lsp release executable. Defaults to based-lsp on PATH. Download the native archive for this extension version and set an absolute executable path when it is not on PATH."
        },
        "basedls.trace.server": {
          "type": "string",
          "enum": [
            "off",
            "messages",
            "verbose"
          ],
          "default": "off",
          "description": "Trace the communication between VS Code and the based-lsp language server."
        }
      }
    }
  },
  "scripts": {
    "vscode:prepublish": "npm run compile",
    "compile": "tsc -p ./",
    "watch": "tsc -watch -p ./",
    "package": "vsce package",
    "test": "node test/preflight.cjs",
    "test:installed": "node test/run.cjs"
  },
  "dependencies": {
    "vscode-languageclient": "^9.0.1"
  },
  "devDependencies": {
    "@types/node": "^20.11.0",
    "@types/vscode": "^1.75.0",
    "@vscode/test-electron": "2.5.2",
    "@vscode/vsce": "^2.24.0",
    "typescript": "^5.4.0"
  }
}
