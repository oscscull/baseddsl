# The Postgres the engine (and `based migrate apply`) runs against. This default
# matches the repo's throwaway server (`make dev-db-up`); edit it to point at your own.
DATABASE_URL=postgres://postgres:based_test_pw@127.0.0.1:15432/based_test

# Optional: the production idempotency store. Set it to run keyed-mutation dedupe through
# Redis (src/redis_store.rs) instead of the in-process MemStore; matches `make dev-db-up`.
# REDIS_URL=redis://127.0.0.1:16379
